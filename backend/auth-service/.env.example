PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-local-password

JWT_SECRET=replace-with-at-least-48-cryptographically-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-48-character-random-value
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_API_KEY=replace-with-another-48-character-random-value
REGISTRATION_ENABLED=true
DB_SSL=false

# Password reset email — ใช้ Resend API
# ตั้งค่าใน Railway Variables ห้ามใส่ key จริงลง GitHub
RESEND_API_KEY=
MAIL_FROM=AHA <no-reply@your-verified-domain.com>
FRONTEND_URL=https://aha-frontend-production.up.railway.app

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
