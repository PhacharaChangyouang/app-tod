# These upstream URLs are server-only. Never expose service credentials to NEXT_PUBLIC_* variables.
AUTH_API_URL=http://localhost:3001
REMINDER_API_URL=http://localhost:3002
NOTIFICATION_API_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Public OAuth Web Client ID. This value is expected to be visible in the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
