# Copy this file to .env for local development. Never commit the real .env.
JWT_SECRET=replace-with-at-least-48-cryptographically-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-48-character-random-value
INTERNAL_API_KEY=replace-with-another-48-character-random-value
# Keep PIN_PEPPER stable. Changing it invalidates newly peppered PIN hashes.
PIN_PEPPER=replace-with-a-stable-fourth-48-character-random-value
POSTGRES_PASSWORD=replace-with-a-strong-local-password
FRONTEND_URL=http://localhost:3000
# Server-only URLs used by the Next.js BFF. Use private service URLs when available.
AUTH_API_URL=http://localhost:3001
REMINDER_API_URL=http://localhost:3002
NOTIFICATION_API_URL=http://localhost:3003
# Production database TLS verifies certificates by default. Set a CA when required.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Production defaults to closed registration unless this is explicitly true.
# เปิดเฉพาะ development; production ให้คงค่า false จนมี verified onboarding
REGISTRATION_ENABLED=false
# Google Login (OAuth Web Client ID is public; signup secret is server-only)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_SIGNUP_SECRET=replace-with-a-distinct-48-character-random-value
