# Copy this file to .env for local development. Never commit the real .env.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-value
INTERNAL_API_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-strong-local-password
FRONTEND_URL=http://localhost:3000
# Production defaults to closed registration unless this is explicitly true.
REGISTRATION_ENABLED=true
